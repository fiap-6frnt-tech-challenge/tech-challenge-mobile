{
  "name": "bytebank-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "test:domain": "vitest run",
    "storybook": "cross-env EXPO_PUBLIC_STORYBOOK=true expo start",
    "storybook:ios": "cross-env EXPO_PUBLIC_STORYBOOK=true expo start --ios",
    "storybook:android": "cross-env EXPO_PUBLIC_STORYBOOK=true expo start --android"
  },
