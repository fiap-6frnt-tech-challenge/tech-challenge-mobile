    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
